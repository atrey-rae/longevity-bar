# ---------------------------------------------------------------------------
# Longevity Bar — proměnné prostředí
# Zkopíruj jako .env.local (lokálně) nebo vlož do Vercel → Settings → Environment Variables.
# .env.local NIKDY necommituj.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → anon / public
# (bezpečné pro prohlížeč, chráněné pomocí RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Supabase → Project Settings → API Keys → service_role (SECRET!)
# Používá se JEN na serveru (route handlery / server actions). Nikdy nedávat na klienta.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Veřejná adresa aplikace (bez lomítka na konci).
# Lokálně: http://localhost:3000 — v produkci: https://bar.peaceandcoco.com
# Používá se pro OAuth redirect a pro obsah QR kódů na tiskové stránce.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (https://resend.com) — odesílání kupónových e-mailů z kvízu bavičů.
# Klíč z Resend → API Keys; doména updates.wildandcoco.com je verifikovaná.
RESEND_API_KEY=re_dummy_key
RESEND_FROM=Longevity Bar <bar@updates.wildandcoco.com>

# Phone-first přihlášení. Pepper musí být náhodný (min. 16 znaků), pouze server.
# Např. `openssl rand -hex 32`; nikdy ho neměň během živého festivalu.
BAR_AUTH_PEPPER=replace-with-random-server-secret

# OptimCall SendSms — stejný tenant/device pattern jako Healing Team app.
OPTIMCALL_TENANT_HOST=wildandcoco.optimcall.cz
OPTIMCALL_USER=admin
# Zapni jen při skutečném provozu za Cloudflare reverse proxy. Na Vercelu
# zůstává prázdné; klientský cf-connecting-ip se pak nikdy nepoužije.
TRUST_CF_HEADERS=
OPTIMCALL_DEVICE_ID=Dinstar-1-733444130
OPTIMCALL_TOKEN=replace-with-optimcall-token

# Produkční alternativa k přímému OPTIMCALL_TOKEN: bezpečný serverový most přes
# Healing.app, která už token drží. Pokud je přímý token nastavený, má přednost.
HEALING_SMS_BRIDGE_URL=https://healing.peaceandcoco.com/api/internal/bar-sms

# CloudSailor care-api (e-shop wildandcoco.com) — zakládání personalizovaných
# kupónů z kvízu. HTTP Basic; heslo NIKDY nedávat do repa ani logů.
# Bez těchto hodnot kvíz tiše přepne na sdílené předgenerované kupóny
# (a pošle notifikaci na atrey@).
CS_CARE_USER=wild-and-coco-care
CS_CARE_PASSWORD=dummy-password

# Sdílený secret interního API pro healing.peaceandcoco.com
# (`/api/internal/healing-dashboard` a `…/quiz-variant`).
# JEN server — nikdy prefix NEXT_PUBLIC_, nikdy do klientského bundlu.
# Stejnou hodnotu musí mít Worker healing.app; posílá ji v hlavičce
# `Authorization: Bearer <secret>`.
# Hodnotu vygeneruj náhodně (např. `openssl rand -hex 32`) a ulož do Vercel →
# Environment Variables (sensitive) + do secretů Workeru. Níž je jen
# ZÁSTUPNÝ TEXT, ne použitelný secret.
# Fail closed: dokud proměnná chybí nebo je prázdná, každý request na interní
# API skončí 401 (viz `src/lib/healing-bridge.ts`).
HEALING_BRIDGE_SECRET=nahrad-nahodnym-tokenem-openssl-rand-hex-32
